SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
JWT_SECRET=
SECRET_KEY=

# Transcripción en vivo
# URL del servicio FastAPI (visto desde el backend Node).
TRANSCRIPTOR_URL=http://localhost:8000
# URL de ESTE backend vista desde el contenedor del transcriptor.
# En Docker Desktop (Mac/Windows) el contenedor llega al host por host.docker.internal.
BACKEND_PUBLIC_URL=http://host.docker.internal:3013

## Puerto en el que escucha el backend (Express + Socket.IO)
PORT=3013

## MySQL externo. Si se dejan vacías, el código cae de vuelta a las credenciales
## reales de producción que ya están hardcodeadas como default en cada archivo
## de backend/src/database/*.ts — solo hace falta llenarlas aquí si este backend
## debe apuntar a un MySQL distinto (p.ej. la LAN de pruebas). DB_HOST_PLENO es
## aparte porque 'pleno' vive en un servidor distinto a las otras 3 bases.
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME_SAF=adminplem_saf
DB_NAME_LEGISLATIVO=adminplem_congresoedomex
DB_NAME_REGISTROCOMISIONES=adminplem_siregistroparlamentario
DB_NAME_PLENO=pleno
DB_HOST_PLENO=

## Espejo de contingencia hacia spid (legado, solo lectura, ver
## services/spidVotingSync.ts). Desactivado por defecto: solo se activa
## explícitamente con SPID_SYNC_ENABLED=true, y ni siquiera abre conexión si
## faltan DB_HOST_SPID/DB_USER_SPID. A diferencia de las demás bases, aquí NO
## hay credenciales de producción hardcodeadas como fallback.
SPID_SYNC_ENABLED=false
DB_HOST_SPID=
DB_PORT_SPID=3306
DB_NAME_SPID=adminplem_spid
DB_USER_SPID=
DB_PASSWORD_SPID=
SPID_SYNC_INTERVAL_MS=3000
